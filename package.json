{
  "name": "@gaddario98/react-native-ui",
  "version": "1.0.25",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c rollup.config.js && rollup -c rollup.dts.config.js",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/react": "^19.2.0",
    "@types/rollup-plugin-peer-deps-external": "^2",
    "babel-plugin-react-compiler": "1",
    "date-fns": "^4.1.0",
    "expo-blur": "^15.0.7",
    "expo-image": "^3.0.9",
    "expo-linear-gradient": "^15.0.7",
    "expo-router": "^6.0.12",
    "i18next": "^25.6.0",
    "react": "^19.2.0",
    "react-i18next": "^16.0.1",
    "react-native": "^0.81.0",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.1",
    "rollup": "^4.40.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=14.0.0",
    "@react-native-community/datetimepicker": ">=7.0.0",
    "date-fns": ">=3.0.0",
    "expo-blur": ">=13.0.0",
    "expo-image": ">=1.0.0",
    "expo-linear-gradient": ">=13.0.0",
    "expo-router": ">=6.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-i18next": ">=13.0.0",
    "react-native": ">=0.70.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@expo/metro-runtime": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "lib",
    "index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.mjs",
      "require": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.mjs",
      "require": "./dist/styles/index.js",
      "default": "./dist/styles/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaddario98/react-native-ui"
  },
  "keywords": [
    "react-native",
    "ui",
    "expo",
    "component-library"
  ],
  "author": "Giosuè Addario ",
  "bugs": {
    "url": "https://github.com/gaddario98/react-native-ui/issues"
  },
  "homepage": "https://github.com/gaddario98/react-native-ui#readme"
}
